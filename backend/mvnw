#!/usr/bin/env sh
# Lightweight Maven Wrapper: downloads the pinned Maven distribution on first use.
set -eu
MAVEN_VERSION="3.9.9"
MAVEN_USER_HOME="${MAVEN_USER_HOME:-${HOME}/.m2}"
MAVEN_HOME="${MAVEN_HOME:-${MAVEN_USER_HOME}/wrapper/dists/apache-maven-${MAVEN_VERSION}}"
if [ ! -x "${MAVEN_HOME}/bin/mvn" ]; then
  mkdir -p "$(dirname "${MAVEN_HOME}")"
  ARCHIVE="${MAVEN_USER_HOME}/wrapper/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
  URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/${MAVEN_VERSION}/apache-maven-${MAVEN_VERSION}-bin.tar.gz"
  if [ ! -f "${ARCHIVE}" ]; then
    mkdir -p "$(dirname "${ARCHIVE}")"
    if command -v curl >/dev/null 2>&1; then curl -fsSL "${URL}" -o "${ARCHIVE}.tmp"
    elif command -v wget >/dev/null 2>&1; then wget -q "${URL}" -O "${ARCHIVE}.tmp"
    else echo "curl or wget is required to download Maven ${MAVEN_VERSION}" >&2; exit 1
    fi
    mv "${ARCHIVE}.tmp" "${ARCHIVE}"
  fi
  TMP_DIR="${MAVEN_HOME}.extract.$$"
  mkdir -p "${TMP_DIR}"
  tar -xzf "${ARCHIVE}" -C "${TMP_DIR}"
  rm -rf "${MAVEN_HOME}"
  mv "${TMP_DIR}/apache-maven-${MAVEN_VERSION}" "${MAVEN_HOME}"
  rmdir "${TMP_DIR}"
fi
exec "${MAVEN_HOME}/bin/mvn" "$@"
