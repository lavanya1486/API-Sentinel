# Local development defaults only. Replace all development secrets before exposing an instance.
POSTGRES_DB=apisentinel
POSTGRES_USER=apisentinel
POSTGRES_PASSWORD=local-change-this-postgres-password

# Generate independently for each environment. JWT_SECRET: at least 32 random UTF-8 bytes.
JWT_SECRET=development-only-change-this-jwt-secret-before-deploying-apisentinel
# Base64-encoded 32-byte AES key. Example decodes to a predictable development-only value.
APP_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_TTL_MINUTES=15

# Origins used when running the frontend through Vite or the Compose reverse proxy.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_PORT=3000

# Monitoring limits and persistent history retention.
MONITOR_SCAN_DELAY_MS=5000
MONITOR_MAX_CONCURRENT_CHECKS=8
HISTORY_RETENTION_DAYS=90
DB_POOL_SIZE=12

# Optional local dev proxy (Vite). The production Compose backend is only exposed through Nginx.
VITE_API_PROXY=http://localhost:8080
